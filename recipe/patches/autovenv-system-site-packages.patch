From: Andrey Vetroumov <avetroumov@anaconda.com>
Date: Wed, 30 Sep 2026 10:19:44 +0000
Subject: [PATCH] autovenv system site packages

---
 scripts/autovenv.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/scripts/autovenv.py b/scripts/autovenv.py
index 5fc2b8ccc..310289c2e 100644
--- a/scripts/autovenv.py
+++ b/scripts/autovenv.py
@@ -169,7 +169,8 @@ def enter(*,
             executable = f'"{sys.executable}"'
         else:
             executable = shlex.quote(sys.executable)
-        run(f'{executable} -m venv {venv_name}', verbose, t0)
+        #run(f'{executable} -m venv {venv_name}', verbose, t0)
+        run(f'{executable} -m venv --system-site-packages {venv_name}', verbose, t0)
 
     # Get command to enter venv.
     if platform.system() == 'Windows':
